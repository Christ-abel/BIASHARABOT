# Express Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/biasharabot?retryWrites=true&w=majority
MONGODB_URI=

# Gemini API Key (voice, text, and receipt-photo parsing)
# Set to 'mock' or leave empty to run in local mock mode without API charges.
# Mock receipt parse returns a fixed sample (see MOCK_RECEIPT in gemini.js).
GEMINI_API_KEY=mock

# PayHero STK Push Configuration
# Set PAYHERO_API_USERNAME to 'mock' or leave blank for local payment simulations
PAYHERO_API_USERNAME=mock
PAYHERO_API_PASSWORD=mock_pass
PAYHERO_CHANNEL_ID=1234
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2/payments/external

# Tiara Connect SMS Configuration (backend/services/sms.js)
# TIARA_API_KEY: bearer token from the Tiara dashboard. Set to 'mock' to log SMS
# locally instead of sending. Leaving it EMPTY is an error: sends fail loudly
# rather than pretending to succeed.
TIARA_API_KEY=mock
# Approved sender ID on your Tiara account (must be whitelisted there).
TIARA_SENDER_ID=CONNECT
# API base URL; only change if Tiara gives you a different endpoint.
TIARA_BASE_URL=https://api2.tiaraconnect.io/api/messaging

# SMS scheduler (backend/scheduler.js, node-cron, Kenya time)
# Weekly till slip: default Sunday 20:00. Credit reminders: default every 6 hours.
# Set either to off when an external cron calls the HTTP job routes instead.
REPORT_SMS_CRON=0 20 * * 0
CREDIT_REMINDER_CRON=0 */6 * * *
# Shared secret for POST /api/jobs/weekly-reports (header X-Cron-Secret). Empty disables that route.
CRON_SECRET=
# Demo: only this shop gets the till slip (even with no sales). With REPEAT=1 and
# REPORT_SMS_CRON=*/2 * * * * it sends every 2 minutes, up to SMS_DEMO_MAX_SENDS SMS.
SMS_DEMO_SHOP=
SMS_DEMO_REPEAT=0
SMS_DEMO_MAX_SENDS=3
